#!/usr/bin/env python3
"""gtheme - live Ghostty theme picker. Up/Down (or j/k) preview, PgUp/PgDn jump, / filter,
Enter = save to config, q/Esc = cancel and restore."""
import argparse
import os
import re
import select
import stat
import subprocess
import sys
import tempfile
import termios
import tty
from pathlib import Path

DEFAULT_THEMES = Path("/Applications/Ghostty.app/Contents/Resources/ghostty/themes")
DEFAULT_CONFIG = Path("~/.config/ghostty/config")
THEME_SETTING = re.compile(r"^[ \t]*theme[ \t]*=[ \t]*(.*)$", re.MULTILINE)

parser = argparse.ArgumentParser(description="Preview and save bundled Ghostty themes on macOS.")
parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG,
                    help="Ghostty config to edit (default: ~/.config/ghostty/config)")
parser.add_argument("--themes-dir", type=Path, default=DEFAULT_THEMES,
                    help="Ghostty theme directory (defaults to /Applications/Ghostty.app)")
args = parser.parse_args()
D = args.themes_dir.expanduser()
CFG = args.config.expanduser()
if not (sys.stdin.isatty() and sys.stdout.isatty()):
    parser.error("open gtheme in an interactive Ghostty terminal")
NAMES=["Catppuccin Mocha", "Catppuccin Macchiato", "Catppuccin Frappe", "Catppuccin Latte", "TokyoNight", "TokyoNight Storm", "TokyoNight Night", "Dracula", "Gruvbox Dark", "Gruvbox Dark Hard", "Nord", "Rose Pine", "Rose Pine Moon", "Rose Pine Dawn", "Kanagawa Wave", "Kanagawa Dragon", "Everforest Dark Hard", "Everforest Light Med", "Solarized Dark Higher Contrast", "One Half Dark", "Atom One Dark", "Nightfox", "Carbonfox", "Github Dark", "Monokai Pro", "Ayu Mirage", "Zenburn", "Synthwave", "Poimandres", "Melange Dark", "Github Light Default", "Github Dark Default", "GitHub Dark Dimmed", "Ayu Light", "Material Darker", "Material Ocean", "Dawnfox", "Dayfox", "Duskfox", "Nordfox", "Terafox", "Night Owl", "Light Owl", "Cobalt2", "Horizon", "Sonokai", "Moonfly", "Iceberg Dark", "Iceberg Light", "Tomorrow Night", "Tomorrow Night Bright", "Tomorrow Night Burns", "Tomorrow Night Eighties", "Tomorrow", "Snazzy", "Monokai Remastered", "Monokai Soda", "Monokai Vivid", "Selenized Dark", "Selenized Light", "Selenized Black", "Gruvbox Light", "Gruvbox Light Hard", "Gruvbox Material", "Gruvbox Material Dark", "Gruvbox Material Light", "Kanagawa Lotus", "TokyoNight Day", "Nord Light", "Nord Wave", "Challenger Deep", "Cyberpunk", "Dark Pastel", "Darkside", "Doom One", "Doom Peacock", "Espresso", "Fahrenheit", "Flat", "Flatland", "Framer", "Fish Tank", "Galaxy", "Hardcore", "Harper", "Hax0r Blue", "Hurtado", "Hybrid", "Jackie Brown", "Kibble", "Laser", "Liquid Carbon", "Lovelace", "Man Page", "Mariana", "Mathias", "Medallion", "Mirage", "Molokai", "Monokai Pro Machine", "Monokai Pro Octagon", "Monokai Pro Ristretto", "Monokai Pro Spectrum", "Neon", "Neopolitan", "Nvim Dark", "Nvim Light", "Obsidian", "Ocean", "Oceanic Next", "One Half Light", "Atom One Light", "Onenord", "Paraiso Dark", "Pencil Dark", "Pencil Light", "Pro", "Red Alert", "Red Planet", "Rouge 2", "Royal", "Seafoam Pastel", "Seoulbones Dark", "Shades Of Purple", "Slate", "Smyck", "Spacedust", "Spiderman", "Square", "Su